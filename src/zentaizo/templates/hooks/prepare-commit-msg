#!/usr/bin/env python3
# managed-hook-id: zentaizo-commit-attribution
"""prepare-commit-msg: append a deterministic ``Co-authored-by`` trailer recording
the AI model + reasoning effort behind the commit.

One shared, tool-agnostic hook with a provider branch per assistant. Each branch
reads a cache that its producer wrote -- ``zentaizo cache-commit-trailer
--<provider>`` -- so attribution stays out of the model's per-commit reasoning:

  - Claude: ``~/.cache/claude/commit-trailer/`` (producer reads the Claude Code
    statusline JSON, the only place the friendly model name is exposed).
  - Codex:  ``~/.cache/codex/commit-trailer/``.

Operational model: installed repo-locally as ``.git/hooks/prepare-commit-msg``.
The installer refuses to overwrite an unrelated project hook, so this never
coexists with (or shadows) another prepare-commit-msg -- hence no chaining.

Properties: FAIL-OPEN (never blocks a commit; any error just skips the trailer),
idempotent per provider, and pure Python standard library (no external tools).
"""

from __future__ import annotations

import json
import os
import pathlib
import re
import sys


def _safe_cache_key(key: str | None) -> str | None:
    if not key:
        return None
    safe = re.sub(r"[^A-Za-z0-9_-]+", "-", key.strip()).strip("-_")
    return safe or None


def _read_cache(provider: str, key: str | None) -> tuple[str, str]:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    cache_dir = pathlib.Path(base) / provider / "commit-trailer"
    candidates = []
    safe_key = _safe_cache_key(key)
    if safe_key:
        candidates.append(cache_dir / f"{safe_key}.json")
    candidates.append(cache_dir / "latest.json")
    for path in candidates:
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(data, dict):
            return str(data.get("model") or ""), str(data.get("effort") or "")
    return "", ""


def _claude_trailer() -> str | None:
    model, effort = _read_cache("claude", os.environ.get("CLAUDE_CODE_SESSION_ID"))
    if not effort:
        effort = os.environ.get("CLAUDE_EFFORT", "")
    if not model:
        return None
    attrib = model
    if effort:
        # Place the reasoning effort inside the model's trailing parens, e.g.
        # "Opus 4.8 (1M context)" -> "Opus 4.8 (1M context, reasoning xhigh)";
        # if there are no parens, append "(reasoning <effort>)".
        if model.rstrip().endswith(")"):
            attrib = re.sub(r"\)\s*$", f", reasoning {effort})", model)
        else:
            attrib = f"{model} (reasoning {effort})"
    return f"Co-authored-by: Claude {attrib} <noreply@anthropic.com>"


def _codex_trailer() -> str | None:
    model, effort = _read_cache("codex", os.environ.get("CODEX_THREAD_ID"))
    if not (model and effort):  # Codex: only attribute when both are cached
        return None
    return f"Co-authored-by: Codex {model} (reasoning {effort}) <noreply@openai.com>"


def _provider_trailer() -> tuple[str, str] | None:
    """Return (provider_name, trailer_line) for the active assistant, or None."""
    if os.environ.get("CLAUDECODE"):
        trailer = _claude_trailer()
        return ("Claude", trailer) if trailer else None
    if os.environ.get("CODEX_THREAD_ID"):
        trailer = _codex_trailer()
        return ("Codex", trailer) if trailer else None
    return None


def _append_trailer(msg_path: pathlib.Path, trailer: str) -> None:
    # Insert before the first comment line (the git template block) so the
    # trailer lands in the message body; otherwise append at the end.
    lines = msg_path.read_text().splitlines()
    out: list[str] = []
    inserted = False
    for line in lines:
        if not inserted and line.startswith("#"):
            out.extend(("", trailer))
            inserted = True
        out.append(line)
    if not inserted:
        out.extend(("", trailer))
    msg_path.write_text("\n".join(out) + "\n")


def main(argv: list[str]) -> int:
    if not argv:
        return 0
    msg_path = pathlib.Path(argv[0])
    source = argv[1] if len(argv) > 1 else ""
    if source in ("merge", "squash"):
        return 0
    resolved = _provider_trailer()
    if resolved is None:
        return 0
    provider, trailer = resolved
    existing = msg_path.read_text()
    # A Reviewed-by line for the provider also counts: `zentaizo commit-trailer`
    # attributes a delegated commit's committer as Reviewed-by, and the hook must
    # not re-add it as a spurious co-author.
    if re.search(rf"(?im)^(?:Co-authored-by|Reviewed-by):\s+{re.escape(provider)}\b", existing):
        return 0  # idempotent per provider (amend / rebase / message reuse)
    _append_trailer(msg_path, trailer)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception:
        sys.exit(0)  # FAIL-OPEN: a hook bug must never block a commit
