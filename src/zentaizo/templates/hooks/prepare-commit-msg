#!/usr/bin/env bash
# managed-hook-id: zentaizo-commit-attribution
# prepare-commit-msg: append a deterministic Co-authored-by trailer recording the
# AI model + reasoning effort behind the commit. One shared, tool-agnostic hook
# with a provider branch per assistant; each branch consumes a cache its own
# producer wrote, so attribution stays out of the model's per-commit reasoning.
#
#   - Claude: cache written by the statusline (see
#     ai-instructions/claude/statusline-command.sh).
#   - Codex:  cache written by Codex's own producer (keyed by CODEX_THREAD_ID).
#
# Design rules:
#   - FAIL-OPEN: any internal problem must NEVER block a commit. We never
#     `set -e`; the script always ends in `exit 0`.
#   - Chain to a repo-local prepare-commit-msg first, so project hooks keep
#     working if this is ever installed via a global core.hooksPath.
#   - Only act inside a recognized assistant session; leave human commits and
#     other tools untouched.
#   - Idempotent: never add a second trailer for the same provider.

msg_file="$1"
commit_source="${2:-}"

# --- chain to a repo-local hook first ---------------------------------------
# Resolve the real .git/hooks dir regardless of core.hooksPath so we can defer
# to a project's own prepare-commit-msg. Respect its exit code (a local veto
# should still abort the commit).
gitdir="$(git rev-parse --git-dir 2>/dev/null)"
if [ -n "$gitdir" ]; then
  local_hook="$gitdir/hooks/prepare-commit-msg"
  self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"
  if [ -x "$local_hook" ]; then
    lh="$(readlink -f "$local_hook" 2>/dev/null || echo "$local_hook")"
    me="$(readlink -f "$self" 2>/dev/null || echo "$self")"
    if [ "$lh" != "$me" ]; then
      "$local_hook" "$@" || exit $?
    fi
  fi
fi

# --- shared preconditions ---------------------------------------------------
case "$commit_source" in merge|squash) exit 0 ;; esac
command -v jq >/dev/null 2>&1 || exit 0

# Insert a trailer line before the first comment line (the git template block)
# so it lands in the message body, not after the comments. Falls back to append.
append_trailer() {
  _t="$1"
  _cc="$(git config --get core.commentChar 2>/dev/null)"
  case "${#_cc}" in 1) ;; *) _cc='#' ;; esac
  _tmp="$(mktemp 2>/dev/null)" || return 0
  awk -v t="$_t" -v cc="$_cc" '
    !done && substr($0,1,length(cc))==cc { print ""; print t; done=1 }
    { print }
    END { if (!done) { print ""; print t } }
  ' "$msg_file" > "$_tmp" 2>/dev/null && mv "$_tmp" "$msg_file" 2>/dev/null
  rm -f "$_tmp" 2>/dev/null
}

# --- Claude branch ----------------------------------------------------------
if [ -n "${CLAUDECODE:-}" ]; then
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude/commit-trailer"
  cache=""
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -f "$cache_dir/$CLAUDE_CODE_SESSION_ID.json" ]; then
    cache="$cache_dir/$CLAUDE_CODE_SESSION_ID.json"
  elif [ -f "$cache_dir/latest.json" ]; then
    cache="$cache_dir/latest.json"
  fi
  [ -n "$cache" ] || exit 0

  model="$(jq -r '.model // empty' "$cache" 2>/dev/null)"
  effort="$(jq -r '.effort // empty' "$cache" 2>/dev/null)"
  [ -n "$effort" ] || effort="${CLAUDE_EFFORT:-}"
  [ -n "$model" ] || exit 0

  grep -qiE '^Co-authored-by: Claude ' "$msg_file" 2>/dev/null && exit 0

  # Place reasoning effort inside the model's trailing parens (e.g.
  # "Opus 4.8 (1M context)" -> "Opus 4.8 (1M context, reasoning xhigh)"); if the
  # model has no parens, append "(reasoning <effort>)".
  attrib="$model"
  if [ -n "$effort" ]; then
    case "$model" in
      *"("*")") attrib="$(printf '%s' "$model" | sed -E "s/\)[[:space:]]*\$/, reasoning ${effort})/")" ;;
      *)        attrib="$model (reasoning $effort)" ;;
    esac
  fi
  append_trailer "Co-authored-by: Claude ${attrib} <noreply@anthropic.com>"
  exit 0
fi

# --- Codex branch -----------------------------------------------------------
if [ -n "${CODEX_THREAD_ID:-}" ]; then
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/codex/commit-trailer"
  cache=""
  if [ -f "$cache_dir/$CODEX_THREAD_ID.json" ]; then
    cache="$cache_dir/$CODEX_THREAD_ID.json"
  elif [ -f "$cache_dir/latest.json" ]; then
    cache="$cache_dir/latest.json"
  fi
  [ -n "$cache" ] || exit 0

  model="$(jq -r '.model // empty' "$cache" 2>/dev/null)"
  effort="$(jq -r '.effort // empty' "$cache" 2>/dev/null)"
  # Codex self-knowledge is shakier: only attribute when BOTH come from the
  # deterministic cache.
  [ -n "$model" ] && [ -n "$effort" ] || exit 0

  grep -qiE '^Co-authored-by: Codex ' "$msg_file" 2>/dev/null && exit 0

  append_trailer "Co-authored-by: Codex ${model} (reasoning ${effort}) <noreply@openai.com>"
  exit 0
fi

exit 0
